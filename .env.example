# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
# ".env" is listed in .gitignore, so it will NEVER be committed to GitHub.
#
# This file is for SECRETS ONLY. Your league ID, team ID and season live in
# "league.json" at the project root, because none of those are sensitive.
# ---------------------------------------------------------------------------

# Your two ESPN login cookies. See README, "Getting your ESPN cookies".
# ESPN_S2 is a very long string with % symbols in it.
# SWID looks like {AAAAAAAA-BBBB-CCCC-DDDD-EEEEEEEEEEEE}, braces included.
ESPN_S2=paste_your_espn_s2_cookie_here
SWID={paste-your-swid-cookie-here}

# ---------------------------------------------------------------------------
# Optional overrides. Leave these commented out unless you need them: the
# values in league.json are used by default.
# ---------------------------------------------------------------------------
# LEAGUE_ID=1283630842
# TEAM_ID=10
# SEASON_YEAR=2026
# TEAM_NAME=
