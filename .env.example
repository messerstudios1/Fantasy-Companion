# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
# ".env" is listed in .gitignore, so it will NEVER be committed to GitHub.
# ---------------------------------------------------------------------------

# Found in your ESPN league URL:
# https://fantasy.espn.com/football/league?leagueId=123456789
LEAGUE_ID=123456789

# The fantasy season year.
SEASON_YEAR=2026

# Your two ESPN login cookies. See README section "Getting your ESPN cookies".
# ESPN_S2 is a very long string. SWID looks like {AAAAAAAA-BBBB-CCCC-DDDD-EEEEEEEEEEEE}
ESPN_S2=paste_your_espn_s2_cookie_here
SWID={paste-your-swid-cookie-here}

# OPTIONAL: your own team's name exactly as it appears in ESPN.
# Leave blank and the tools will auto-detect your team from the SWID cookie.
TEAM_NAME=
